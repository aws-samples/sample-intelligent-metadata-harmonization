# MacOS DS Store
.DS_Store

# CDK
cdk.out/

# CDK context cache. Regenerated by `cdk synth`/`deploy` and bakes in real AWS
# account IDs plus AZ/prefix-list lookups -- untracked to avoid committing those
# and the diff churn from automatic regeneration.
projects/infra/cdk.context.json

# Compiled TypeScript output for the CDK app -- ts-node runs bin/*.ts directly
# (see cdk.json "app"), so these are build byproducts, not runtime dependencies.
projects/infra/lib/**/*.js
projects/infra/lib/**/*.d.ts
projects/infra/bin/**/*.js
projects/infra/bin/**/*.d.ts

# Next.js build artifacts
.next/
out/

# TypeScript incremental build info
*.tsbuildinfo

